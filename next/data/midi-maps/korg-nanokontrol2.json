{
  "name": "Korg nanoKONTROL2, factory CC mode",
  "match": "nanoKONTROL2",
  "verify": "verify with the wizard: CC numbers are Korg's factory CC mode as documented (channel 1), not seen on hardware. Same roles as the original nanoKONTROL on strips 1 to 8: upper = S, lower = R. Strip 9 of the original has no place here: MARKER SET hides the controls, TRACK < flips the FX direction.",
  "layout": {
    "strips": 8,
    "fader": [0, 1, 2, 3, 4, 5, 6, 7],
    "knob": [16, 17, 18, 19, 20, 21, 22, 23],
    "upper": [32, 33, 34, 35, 36, 37, 38, 39],
    "lower": [64, 65, 66, 67, 68, 69, 70, 71],
    "transport": { "PLAY": 41, "STOP": 42, "REW": 43, "FF": 44, "REC": 45, "CYCLE": 46, "TRACK<": 58, "TRACK>": 59, "SET": 60, "MARKER<": 61, "MARKER>": 62 }
  },
  "bindings": [
    { "act": "play", "type": "cc", "ch": 0, "num": 41, "mode": "momentary", "where": "PLAY" },
    { "act": "black", "type": "cc", "ch": 0, "num": 42, "mode": "momentary", "where": "STOP" },
    { "act": "back", "type": "cc", "ch": 0, "num": 43, "mode": "momentary", "where": "REW" },
    { "act": "forward", "type": "cc", "ch": 0, "num": 44, "mode": "momentary", "where": "FF" },
    { "act": "clean", "type": "cc", "ch": 0, "num": 46, "mode": "momentary", "where": "CYCLE" },
    { "act": "panic", "type": "cc", "ch": 0, "num": 45, "mode": "momentary", "hold_ms": 1000, "where": "REC" },
    { "act": "hide", "type": "cc", "ch": 0, "num": 60, "mode": "momentary", "where": "MARKER SET" },
    { "act": "fxDir", "type": "cc", "ch": 0, "num": 58, "mode": "momentary", "where": "TRACK <" },

    { "act": "fxSlit", "type": "cc", "ch": 0, "num": 16, "where": "strip 1 knob" },
    { "act": "fxMix", "type": "cc", "ch": 0, "num": 0, "where": "strip 1 fader" },
    { "act": "black", "type": "cc", "ch": 0, "num": 32, "mode": "momentary", "where": "strip 1 S" },
    { "act": "reseed", "type": "cc", "ch": 0, "num": 64, "mode": "momentary", "where": "strip 1 R" },
    { "act": "fxWidth", "type": "cc", "ch": 0, "num": 17, "where": "strip 2 knob" },
    { "act": "speed", "type": "cc", "ch": 0, "num": 1, "where": "strip 2 fader" },
    { "act": "speedReset", "type": "cc", "ch": 0, "num": 33, "mode": "momentary", "where": "strip 2 S" },
    { "act": "dir", "type": "cc", "ch": 0, "num": 65, "mode": "momentary", "where": "strip 2 R" },
    { "act": "ink", "type": "cc", "ch": 0, "num": 18, "where": "strip 3 knob" },
    { "act": "contrast", "type": "cc", "ch": 0, "num": 2, "where": "strip 3 fader" },
    { "act": "palNext", "type": "cc", "ch": 0, "num": 34, "mode": "momentary", "where": "strip 3 S" },
    { "act": "palPrev", "type": "cc", "ch": 0, "num": 66, "mode": "momentary", "where": "strip 3 R" },
    { "act": "wind", "type": "cc", "ch": 0, "num": 19, "where": "strip 4 knob" },
    { "act": "rain", "type": "cc", "ch": 0, "num": 3, "where": "strip 4 fader" },
    { "act": "weatherAuto", "type": "cc", "ch": 0, "num": 35, "mode": "momentary", "where": "strip 4 S" },
    { "act": "timeRun", "type": "cc", "ch": 0, "num": 67, "mode": "momentary", "where": "strip 4 R" },
    { "act": "fog", "type": "cc", "ch": 0, "num": 20, "where": "strip 5 knob" },
    { "act": "water", "type": "cc", "ch": 0, "num": 4, "where": "strip 5 fader" },
    { "act": "bank", "type": "cc", "ch": 0, "num": 36, "mode": "momentary", "where": "strip 5 S" },
    { "act": "mode", "type": "cc", "ch": 0, "num": 68, "mode": "momentary", "where": "strip 5 R" },
    { "act": "light", "type": "cc", "ch": 0, "num": 21, "where": "strip 6 knob" },
    { "act": "master", "type": "cc", "ch": 0, "num": 5, "where": "strip 6 fader" },
    { "act": "hold", "type": "cc", "ch": 0, "num": 37, "mode": "momentary", "where": "strip 6 S" },
    { "act": "sections", "type": "cc", "ch": 0, "num": 69, "mode": "momentary", "where": "strip 6 R" },
    { "act": "weather", "type": "cc", "ch": 0, "num": 22, "where": "strip 7 knob" },
    { "act": "drift", "type": "cc", "ch": 0, "num": 6, "where": "strip 7 fader" },
    { "act": "fxMode", "type": "cc", "ch": 0, "num": 38, "mode": "momentary", "where": "strip 7 S" },
    { "act": "fxFreeze", "type": "cc", "ch": 0, "num": 70, "mode": "momentary", "where": "strip 7 R" },
    { "act": "ve", "type": "cc", "ch": 0, "num": 23, "where": "strip 8 knob" },
    { "act": "morph", "type": "cc", "ch": 0, "num": 7, "where": "strip 8 fader" },
    { "act": "star", "type": "cc", "ch": 0, "num": 39, "mode": "momentary", "where": "strip 8 S" },
    { "act": "world", "type": "cc", "ch": 0, "num": 71, "mode": "momentary", "where": "strip 8 R" }
  ]
}
